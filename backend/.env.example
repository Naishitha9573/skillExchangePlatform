SECRET_KEY=
DATABASE_URL=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Optional live AI. Keep this key only on the backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEMO_MODE=false

# Realtime chat and private WebRTC rooms use /api/v1/ws.
# Deploy a single worker; see docs/COLLABORATION.md for proxy and scaling notes.
# Comma-separated STUN servers. Empty permits local-network host candidates only.
STUN_URLS=stun:stun.l.google.com:19302
# Optional self-hosted coturn. Set these in deployment secrets, never in frontend code.
TURN_URLS=
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=14400
